<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Silvia.App</RootNamespace>
    <AssemblyName>Silvia</AssemblyName>
    <UseWindowsForms>false</UseWindowsForms>
    <DefaultItemExcludes>$(DefaultItemExcludes);frontend/node_modules/**;frontend/dist/**;frontend/dist-mock/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NeoAstra" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Silvia.Core\Silvia.Core.csproj" />
  </ItemGroup>

</Project>
