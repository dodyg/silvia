{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "#neoastra": ["../obj/neoastra/neoastra.ts"],
      "@neoastra/client": ["./node_modules/@neoastra/client/dist/index.d.ts"]
    }
  },
  "include": ["src", "vite-env.d.ts"]
}
